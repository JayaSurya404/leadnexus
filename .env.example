
# ============================================================
# LeadNexus
# Environment variable template
# ============================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SERVER ONLY - never expose this value in browser code
SUPABASE_SECRET_KEY=sb_secret_your_secret_here

# ------------------------------------------------------------
# Optional AI providers
# ------------------------------------------------------------

GOOGLE_GENERATIVE_AI_API_KEY=

OPENAI_API_KEY=

# ------------------------------------------------------------
# Optional email
# ------------------------------------------------------------

RESEND_API_KEY=

RESEND_FROM_EMAIL=

# ------------------------------------------------------------
# VoiceNexus structured handoff
# ------------------------------------------------------------

# SERVER ONLY
# LeadNexus and VoiceNexus must share the same secret.
VOICENEXUS_SHARED_SECRET=

# VoiceNexus server import endpoint. Production must use deployed HTTPS.
VOICENEXUS_IMPORT_URL=http://127.0.0.1:3001/api/v1/integrations/leadnexus
